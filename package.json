{
  "name": "hockey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "cf/worker/node_modules/.bin/wrangler dev --config cf/worker/wrangler.toml --ip 127.0.0.1 --port 8796 --persist-to .scratch/runtime/worker-state",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && npm --prefix cf/worker run check",
    "test:online": "node scripts/test-online.mjs",
    "deploy:worker": "npm --prefix cf/worker run deploy"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "ws": "^8.22.0"
  }
}
